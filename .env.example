APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Keep this false everywhere except local development: it renders full stack
# traces and database queries to anyone who can reach an error page.
APP_DEBUG=false
APP_URL=http://localhost:8000
# Deployed values: APP_ENV=production, APP_DEBUG=false, and APP_URL set to the
# https public address (e.g. https://<account>.alwaysdata.net).

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL is the production database (see BADBAADO_SOURCE_OF_TRUTH.md). On
# Alwaysdata, create the database under Databases > MySQL, then copy the host,
# database name, user and password shown there into the values below.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=badbaado
DB_USERNAME=root
DB_PASSWORD=

# SQLite alternative (single file, no database server). Uncomment to use it.
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Derives from APP_URL when unset: true for https, false for plain http.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing in Badbaado queues jobs today, and free plans generally cannot run a
# persistent worker. Keep sync unless a real queued job is introduced.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Default `log` writes mail to storage/logs instead of sending it, which is what
# you want locally. Password reset links are emitted by the framework's ResetPassword
# notification, so switching to `smtp` below is all that is needed to make them real.
#
# Gmail / Google Workspace:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtls
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=badbaado-notifications@yourdomain.com
#   MAIL_PASSWORD=<google-app-password>
#   MAIL_FROM_ADDRESS="badbaado-notifications@yourdomain.com"
#
# MAIL_PASSWORD must be a Google App Password (16 chars from
# https://myaccount.google.com/apppasswords), not the account password. Turn on
# 2-Step Verification first. Note that MAIL_SCHEME=smtps on port 465 is required
# on some shared hosts instead of the 587/STARTTLS pair above.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
